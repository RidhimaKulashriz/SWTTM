{
  "id": "demo-tracker",
  "name": "Create ticket, label it, close it",
  "executor": "mock",
  "inputs": { "title": "Checkout crashes on empty cart", "label": "bug", "finalState": "done" },
  "steps": [
    {
      "id": "create",
      "canonical_id": "tracker.issue.create",
      "input": { "body": { "title": "{{inputs.title}}" } },
      "sideEffect": true,
      "compensate": { "canonical_id": "tracker.issue.delete", "input": { "path": { "id": "{{steps.create.output.id}}" } } }
    },
    {
      "id": "label",
      "canonical_id": "tracker.issue.label",
      "input": { "path": { "id": "{{steps.create.output.id}}" }, "body": { "label": "{{inputs.label}}" } },
      "sideEffect": true,
      "compensate": {
        "canonical_id": "tracker.issue.unlabel",
        "input": { "path": { "id": "{{steps.create.output.id}}" }, "body": { "label": "{{inputs.label}}" } }
      }
    },
    {
      "id": "close",
      "canonical_id": "tracker.issue.update",
      "input": { "path": { "id": "{{steps.create.output.id}}" }, "body": { "state": "{{inputs.finalState}}" } },
      "sideEffect": true
    }
  ]
}
